# Скопируйте этот файл в .env и заполните сами. Файл .env не публикуйте и никому не присылайте.

# ВКонтакте: ключ доступа сообщества и ID сообщества (число без минуса)
VK_GROUP_TOKEN=
VK_GROUP_ID=

# Нейросеть: бесплатная модель через OpenRouter. Ключ создаётся на https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# По желанию: ваш числовой ID во ВКонтакте, куда бот будет присылать новые заявки
ADMIN_VK_ID=
